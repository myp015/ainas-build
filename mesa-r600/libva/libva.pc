prefix=/usr/local
includedir=${prefix}/include
libdir=${prefix}/lib

# 只提供编译期头文件：Mesa 的 VA 驱动不链接 libva（由 libva 反向加载驱动），
# Libs 留空即可。Version 必须是 VA API 版本（1.22.0），Mesa 用它生成
# __vaDriverInit_<major>_<minor> 入口符号。
Name: va
Description: Userspace Video Acceleration (VA) core interface (headers only)
Version: 1.22.0
Libs:
Cflags: -I${includedir}
